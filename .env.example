# CopilotKit + Vue + Claude Agent SDK (Python) test suite — environment
#
# Three processes, two env files:
#
#   backend/.env    read by the Python agent server (load_dotenv)
#   frontend/.env   read by the Copilot Runtime (server.ts, dotenv) and by Vite
#
# Copy the relevant block into each. Never commit the filled-in files.


# ── backend/.env ─────────────────────────────────────────────────────────────

# Anthropic API key for the Claude Agent SDK. OPTIONAL: when unset, the SDK's
# bundled Claude Code CLI uses this machine's Claude Code login instead. If set,
# it wins, so a key with no credit fails every run with "Credit balance is too low".
# ANTHROPIC_API_KEY=sk-ant-...

# Model every agent runs on. Default: claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Where the agent server listens. Default 8100 (the runtime's AGENT_URL must match).
# AGENT_PORT=8100


# ── frontend/.env — Copilot Runtime (server.ts) ─────────────────────────────

# Runtime port. Default 8300 (Vite's VITE_RUNTIME_ORIGIN must match).
# PORT=8300

# Where the runtime forwards agent runs. Default http://localhost:8100
# AGENT_URL=http://localhost:8100

# Only the Built-in Agent / model-router pages call a model from Node. Without a
# key those demos fail at run time (they are marked so in the app).
# OPENAI_API_KEY=sk-...

# CopilotKit Intelligence (premium) — persists threads server-side and unlocks
# the threads drawer together with the license token. Without them the Threads
# pages fall back to in-memory behaviour (see their status notes).
# CPK_INTELLIGENCE_API_KEY=
# COPILOTKIT_LICENSE_TOKEN=


# ── frontend/.env — Vite ─────────────────────────────────────────────────────

# VITE_PORT=5273
# VITE_RUNTIME_ORIGIN=http://localhost:8300
# VITE_AGENT_ORIGIN=http://localhost:8100

# Set to `off` to hide the CopilotKit Inspector app-wide (e.g. for recordings).
# VITE_COPILOTKIT_INSPECTOR=off
