{
  "name": "cpk-vue-claude-sdk-python-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n runtime,vite -c magenta,cyan \"npm:runtime\" \"npm:vite\"",
    "vite": "vite",
    "runtime": "tsx watch --clear-screen=false server.ts",
    "runtime:once": "tsx server.ts",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.2",
    "@ai-sdk/anthropic": "^4.0.102",
    "@ai-sdk/openai": "^4.0.115",
    "@copilotkit/runtime": "^1.87.0",
    "@copilotkit/sqlite-runner": "^1.87.0",
    "@copilotkit/vue": "^1.87.0",
    "@tanstack/ai": "^1.4.0",
    "@tanstack/ai-anthropic": "^1.1.1",
    "@tanstack/ai-openai": "^1.1.1",
    "ai": "^7.0.170",
    "chart.js": "^4.6.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "lucide-vue-next": "^1.0.0",
    "maplibre-gl": "^5.24.1",
    "shiki": "^4.6.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
